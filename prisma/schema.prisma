generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model brands {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique
  cars cars[]
}

model car_features {
  car_id     String   @db.Uuid
  feature_id String   @db.Uuid
  cars       cars     @relation(fields: [car_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  features   features @relation(fields: [feature_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([car_id, feature_id])
  @@index([feature_id])
}

model car_images {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  car_id     String  @db.Uuid
  url        String
  is_primary Boolean @default(false)
  sort_order Int     @default(0)
  cars       cars    @relation(fields: [car_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([car_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cars {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand_id        String         @db.Uuid
  category_id     String         @db.Uuid
  title           String
  engine          String?
  fuel_type       String?
  transmission    String?
  body_style      String?
  production_year Int?           @db.SmallInt
  mileage_km      Int?
  price_cents     BigInt?
  seat_count      Int?           @db.SmallInt
  horsepower      Int?           @db.SmallInt
  extra_info      Json           @default("{}")
  is_active       Boolean        @default(true)
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  updated_at      DateTime       @default(now()) @db.Timestamptz(6)
  car_features    car_features[]
  car_images      car_images[]
  brands          brands         @relation(fields: [brand_id], references: [id], onUpdate: NoAction)
  categories      categories     @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  favorites       favorites[]

  @@index([brand_id])
  @@index([category_id])
  @@index([extra_info], type: Gin)
  @@index([fuel_type])
  @@index([price_cents])
  @@index([production_year])
}

model categories {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique
  cars cars[]
}

model favorites {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  car_id     String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  cars       cars     @relation(fields: [car_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, car_id])
  @@index([car_id])
  @@index([user_id])
}

model features {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String         @unique
  group_name   String
  car_features car_features[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model user_preferences {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                String   @unique @db.Uuid
  preferred_fuel         String?
  preferred_transmission String?
  preferred_body_style   String?
  budget_max_cents       BigInt?
  year_min               Int?     @db.SmallInt
  year_max               Int?     @db.SmallInt
  seat_count_min         Int?     @db.SmallInt
  updated_at             DateTime @default(now()) @db.Timestamptz(6)
  users                  users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username         String            @unique @db.Citext
  first_name       String
  last_name        String
  email            String            @unique @db.Citext
  password_hash    String
  is_active        Boolean           @default(true)
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime          @default(now()) @db.Timestamptz(6)
  favorites        favorites[]
  user_preferences user_preferences?

  @@index([email])
}
